# Copy to docker/.env and adjust.
# Directory containing ema.safetensors, ae.safetensors, llm_config.json, ...
MODEL_DIR=/mnt/big_data/models/SenseNova-Vision-7B-MoT
HF_CACHE_DIR=~/.cache/huggingface
# Host datasets root, mounted read-only at /datasets.
DATASETS_DIR=/mnt/big_data/datasets
DEMO_PORT=9001
# Host user/group the container runs as (`id -u` / `id -g`).
HOST_UID=1000
HOST_GID=1000
# Inference precision / GPU budget (bf16 + 25GiB fits a 32GB RTX 5090; nf4 is faster).
SENSENOVA_DTYPE=bf16
SENSENOVA_MAX_MEM_PER_GPU=25GiB
